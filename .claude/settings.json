{

  "permissions": {
    "allow": [
       "Bash(tooling/run-prod-query.bat *)",
       "Bash(cmd //c \"tooling\\\\run-prod-query.bat *)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\" || true",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
