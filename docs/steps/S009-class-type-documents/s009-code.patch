+@dataclass(frozen=True)
+class Owner:
+    column: str                    # the owner column of equipment_documents
+    path: str                      # the documents collection URL; {} is the owner's id
+    read: Callable                 # (cur, id) -> row; 404 when missing or not visible
+    read_for_change: Callable      # (cur, id) -> row; read plus a write's early refusals
+    lock_for_change: Callable      # (cur, id), in the write transaction; 404 / 409
+
+
+OWNERS = {
+    "equipment": Owner("equipment_id", "/api/equipment/{}/documents",
