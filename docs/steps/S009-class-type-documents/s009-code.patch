+def _found(row):
+    """The row, or a 404 when there is none."""
+    if row is None:
+        raise ApiError("Not found", 404)
+    return row
+
+
+def _read_node(cur, node_id):
+    """Plain read with unit access (404 outside the user's units)."""
+    _, node = load_node_for_user(cur, node_id, for_update=False)
+    return node
+
+
+def _read_node_for_change(cur, node_id):
+    """Plain read and an early scrapped check, so a scrapped node gets no file read or
+    written.  The decision that counts is the locked one (_lock_node_for_change)."""
+    node = _read_node(cur, node_id)
+    if node["status"] == SCRAPPED:
+        raise ApiError(SCRAPPED_MESSAGE, 409)
+    return node
+
+
+def _lock_node_for_change(cur, node_id):
+    """Lock the node (1) and refuse a scrapped one from the locked row (S002 BR3-01);
+    access is re-checked from the locked state (S006 CR1-01)."""
+    locked, _ = load_node_for_user(cur, node_id, for_update=True)
+    if locked["status"] == SCRAPPED:
+        raise ApiError(SCRAPPED_MESSAGE, 409)
+
+
+def _read_class(cur, class_id):
+    cur.execute("SELECT id, code, name, active FROM equipment_classes WHERE id = %s", (class_id,))
+    return _found(cur.fetchone())
+
+
+def _lock_class(cur, class_id):
+    """Lock (4).  No state to decide: an inactive class keeps editable documents (§ 5.1)."""
+    cur.execute("SELECT id, code, name, active FROM equipment_classes WHERE id = %s FOR UPDATE", (class_id,))
+    _found(cur.fetchone())
+
+
+def _read_type(cur, type_id):
+    """The type with its class's code and name (a plain join, for display)."""
+    cur.execute("SELECT t.id, t.class_id, t.name, t.active, c.code AS class_code, c.name AS class_name "
+                "FROM equipment_types t JOIN equipment_classes c ON c.id = t.class_id WHERE t.id = %s",
+                (type_id,))
+    return _found(cur.fetchone())
+
+
+def _lock_type(cur, type_id):
+    """Lock (5), on the type row alone."""
+    cur.execute("SELECT id, class_id, name, active FROM equipment_types WHERE id = %s FOR UPDATE", (type_id,))
+    _found(cur.fetchone())
